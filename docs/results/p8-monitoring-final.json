{
  "dashboards": {
    "Batching": [
      {
        "panel": "Batch size mean",
        "expr": "sum by (model) (rate(worker_batch_size_sum[1m])) / sum by (model) (rate(worker_batch_size_count[1m]))",
        "status": "success"
      },
      {
        "panel": "Batch size distribution",
        "expr": "sum by (le,model) (rate(worker_batch_size_bucket[1m]))",
        "status": "success"
      },
      {
        "panel": "Batch wait mean",
        "expr": "sum by (model) (rate(worker_batch_wait_seconds_sum[1m])) / sum by (model) (rate(worker_batch_wait_seconds_count[1m]))",
        "status": "success"
      },
      {
        "panel": "Inference mean",
        "expr": "sum by (model) (rate(worker_inference_seconds_sum[1m])) / sum by (model) (rate(worker_inference_seconds_count[1m]))",
        "status": "success"
      },
      {
        "panel": "Busy ratio",
        "expr": "worker_busy_ratio",
        "status": "success"
      },
      {
        "panel": "Outcomes / second",
        "expr": "sum by (model,outcome) (rate(worker_items_total[1m]))",
        "status": "success"
      },
      {
        "panel": "Reclaims",
        "expr": "sum by (model) (increase(worker_reclaimed_total[5m]))",
        "status": "success"
      }
    ],
    "LLM": [
      {
        "panel": "Worker TTFT p95",
        "expr": "histogram_quantile(0.95, sum by (le,model) (rate(worker_ttft_seconds_bucket[1m])))",
        "status": "success"
      },
      {
        "panel": "Gateway TTFT p95",
        "expr": "histogram_quantile(0.95, sum by (le,model) (rate(gateway_ttft_seconds_bucket[1m])))",
        "status": "success"
      },
      {
        "panel": "TPOT mean",
        "expr": "sum by (model) (rate(worker_tpot_seconds_sum[1m])) / sum by (model) (rate(worker_tpot_seconds_count[1m]))",
        "status": "success"
      },
      {
        "panel": "Completion tokens / second",
        "expr": "sum by (model) (rate(worker_tokens_generated_total[1m]))",
        "status": "success"
      },
      {
        "panel": "Active sequences",
        "expr": "worker_inflight_sequences",
        "status": "success"
      },
      {
        "panel": "Engine active sequences",
        "expr": "vllm:num_requests_running",
        "status": "success"
      }
    ],
    "Overview": [
      {
        "panel": "RPS",
        "expr": "sum by (model,status) (rate(gateway_requests_total[1m]))",
        "status": "success"
      },
      {
        "panel": "Latency p50",
        "expr": "histogram_quantile(0.5, sum by (le,model) (rate(gateway_request_duration_seconds_bucket[1m])))",
        "status": "success"
      },
      {
        "panel": "Latency p95",
        "expr": "histogram_quantile(0.95, sum by (le,model) (rate(gateway_request_duration_seconds_bucket[1m])))",
        "status": "success"
      },
      {
        "panel": "Latency p99",
        "expr": "histogram_quantile(0.99, sum by (le,model) (rate(gateway_request_duration_seconds_bucket[1m])))",
        "status": "success"
      },
      {
        "panel": "Errors / second",
        "expr": "sum by (model,status) (rate(gateway_requests_total{status=~\"4..|5..\"}[1m]))",
        "status": "success"
      },
      {
        "panel": "Backlog",
        "expr": "queue_backlog",
        "status": "success"
      },
      {
        "panel": "Workers alive",
        "expr": "workers_alive",
        "status": "success"
      },
      {
        "panel": "Queue wait mean",
        "expr": "sum by (model) (rate(gateway_queue_wait_seconds_sum[1m])) / sum by (model) (rate(gateway_queue_wait_seconds_count[1m]))",
        "status": "success"
      },
      {
        "panel": "Head age",
        "expr": "queue_head_age_seconds",
        "status": "success"
      },
      {
        "panel": "Pending",
        "expr": "queue_pending",
        "status": "success"
      },
      {
        "panel": "DLQ entries",
        "expr": "queue_dlq_entries",
        "status": "success"
      }
    ],
    "Autoscaler": [
      {
        "panel": "Desired replicas",
